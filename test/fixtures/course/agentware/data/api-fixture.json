[
  {
    "id": "chat",
    "vendor": "OpenAI-compatible",
    "method": "POST",
    "path": "/v1/chat/completions",
    "servers": "OpenAI, vLLM, SGLang, Ollama, OpenRouter, LM Studio",
    "summary": "Send the conversation and the tools. The server applies the model's chat template and parses tool calls back into JSON.",
    "headers": [
      {
        "n": "Authorization",
        "t": "string",
        "d": "Bearer <API key>",
        "r": true,
        "k": [],
        "tag": null
      }
    ],
    "req": [
      {
        "n": "model",
        "t": "string",
        "d": "Model id.",
        "r": true,
        "k": [],
        "tag": null
      },
      {
        "n": "messages",
        "t": "array<Message>",
        "d": "The full conversation so far. The API is stateless, so send everything every time.",
        "r": true,
        "k": [
          {
            "n": "role",
            "t": "\"system\" | \"user\" | \"assistant\" | \"tool\"",
            "d": "",
            "r": true,
            "k": [],
            "tag": null
          },
          {
            "n": "content",
            "t": "string | null",
            "d": "null on an assistant turn that only calls tools.",
            "r": false,
            "k": [],
            "tag": null
          },
          {
            "n": "tool_calls",
            "t": "array<ToolCall>",
            "d": "Assistant turns only. Echo back exactly what the model returned.",
            "r": false,
            "k": [],
            "tag": "tools"
          },
          {
            "n": "tool_call_id",
            "t": "string",
            "d": "Tool turns only. Which call this result answers.",
            "r": false,
            "k": [],
            "tag": "tools"
          }
        ],
        "tag": null
      },
      {
        "n": "tools",
        "t": "array<Tool>",
        "d": "Every tool the model may call. Send them on every request.",
        "r": false,
        "k": [
          {
            "n": "type",
            "t": "\"function\"",
            "d": "",
            "r": true,
            "k": [],
            "tag": null
          },
          {
            "n": "function",
            "t": "object",
            "d": "",
            "r": true,
            "k": [
              {
                "n": "name",
                "t": "string",
                "d": "What the model writes to call it.",
                "r": true,
                "k": [],
                "tag": null
              },
              {
                "n": "description",
                "t": "string",
                "d": "When to use it. This is a prompt.",
                "r": false,
                "k": [],
                "tag": null
              },
              {
                "n": "parameters",
                "t": "JSON Schema",
                "d": "The arguments.",
                "r": false,
                "k": [],
                "tag": null
              }
            ],
            "tag": null
          }
        ],
        "tag": "tools"
      },
      {
        "n": "tool_choice",
        "t": "\"auto\" | \"none\" | \"required\" | object",
        "d": "Default auto. An object forces one named tool.",
        "r": false,
        "k": [],
        "tag": "tools"
      },
      {
        "n": "parallel_tool_calls",
        "t": "boolean",
        "d": "Allow several calls in one turn.",
        "r": false,
        "k": [],
        "tag": "tools"
      }
    ],
    "res": [
      {
        "n": "choices[]",
        "t": "array",
        "d": "",
        "r": true,
        "k": [
          {
            "n": "message",
            "t": "object",
            "d": "",
            "r": true,
            "k": [
              {
                "n": "role",
                "t": "\"assistant\"",
                "d": "",
                "r": true,
                "k": [],
                "tag": null
              },
              {
                "n": "content",
                "t": "string | null",
                "d": "Text answer, or null when calling tools.",
                "r": false,
                "k": [],
                "tag": null
              },
              {
                "n": "tool_calls[]",
                "t": "array",
                "d": "Present when the model wants tools.",
                "r": false,
                "k": [
                  {
                    "n": "id",
                    "t": "string",
                    "d": "Send this back as tool_call_id.",
                    "r": true,
                    "k": [],
                    "tag": null
                  },
                  {
                    "n": "type",
                    "t": "\"function\"",
                    "d": "",
                    "r": true,
                    "k": [],
                    "tag": null
                  },
                  {
                    "n": "function.name",
                    "t": "string",
                    "d": "",
                    "r": true,
                    "k": [],
                    "tag": null
                  },
                  {
                    "n": "function.arguments",
                    "t": "string",
                    "d": "A JSON-encoded string. You must json.loads() it.",
                    "r": true,
                    "k": [],
                    "tag": null
                  }
                ],
                "tag": "tools"
              },
              {
                "n": "reasoning_content",
                "t": "string",
                "d": "Server extension (vLLM, DeepSeek, Qwen). Some servers call it reasoning.",
                "r": false,
                "k": [],
                "tag": "reasoning"
              }
            ],
            "tag": null
          },
          {
            "n": "finish_reason",
            "t": "\"stop\" | \"length\" | \"tool_calls\"",
            "d": "tool_calls means run tools, then call again.",
            "r": true,
            "k": [],
            "tag": "tools"
          }
        ],
        "tag": null
      }
    ],
    "ex_req": "{\n  \"model\": \"Qwen/Qwen3-8B\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a concise weather assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Do I need an umbrella in Tokyo?\"\n    }\n  ],\n  \"tools\": [\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"get_weather\",\n        \"description\": \"Get the current weather for a city.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"city\": {\n              \"type\": \"string\",\n              \"description\": \"City name, e.g. Tokyo\"\n            },\n            \"unit\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"celsius\",\n                \"fahrenheit\"\n              ]\n            }\n          },\n          \"required\": [\n            \"city\"\n          ]\n        }\n      }\n    }\n  ]\n}",
    "ex_res": "{\n  \"choices\": [\n    {\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": null,\n        \"tool_calls\": [\n          {\n            \"id\": \"call_1\",\n            \"type\": \"function\",\n            \"function\": {\n              \"name\": \"get_weather\",\n              \"arguments\": \"{\\\"city\\\": \\\"Tokyo\\\"}\"\n            }\n          }\n        ]\n      },\n      \"finish_reason\": \"tool_calls\"\n    }\n  ]\n}"
  },
  {
    "id": "list",
    "vendor": "MCP",
    "method": "RPC",
    "path": "tools/list",
    "servers": "Any MCP server, over stdio or HTTP",
    "summary": "Ask the server which tools it has. Each one has the same three parts as Lesson 2.",
    "headers": [],
    "req": [
      {
        "n": "jsonrpc",
        "t": "\"2.0\"",
        "d": "",
        "r": true,
        "k": [],
        "tag": null
      },
      {
        "n": "id",
        "t": "number | string",
        "d": "",
        "r": true,
        "k": [],
        "tag": null
      },
      {
        "n": "method",
        "t": "\"tools/list\"",
        "d": "",
        "r": true,
        "k": [],
        "tag": null
      }
    ],
    "res": [
      {
        "n": "result.tools[]",
        "t": "array",
        "d": "",
        "r": true,
        "k": [
          {
            "n": "name",
            "t": "string",
            "d": "",
            "r": true,
            "k": [],
            "tag": null
          },
          {
            "n": "description",
            "t": "string",
            "d": "",
            "r": false,
            "k": [],
            "tag": null
          },
          {
            "n": "inputSchema",
            "t": "JSON Schema",
            "d": "Rename to parameters or input_schema for your model.",
            "r": true,
            "k": [],
            "tag": "tools"
          }
        ],
        "tag": null
      }
    ],
    "ex_req": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}",
    "ex_res": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"result\": {\n    \"tools\": [\n      {\n        \"name\": \"get_weather\",\n        \"description\": \"Get the current weather for a city.\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"city\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"city\"\n          ]\n        }\n      }\n    ]\n  }\n}"
  }
]
