{
  "gaps": [
    {
      "area": "GPT-OSS",
      "sev": "medium",
      "wire": "Harmony channels",
      "aw": "Mapped to the OpenAI JSON formatter",
      "effect": "Works through chat completions. Raw mode isn't supported."
    },
    {
      "area": "MiniMax",
      "sev": "medium",
      "wire": "<minimax:tool_call><invoke name=…>",
      "aw": "Python and TypeScript use GenericFormatter. Go matches <tool_call><tool_name>.",
      "effect": "Text-mode parsing misses real calls."
    }
  ],
  "repro": {
    "sdk_version": "0.18.1",
    "entries": [
      {
        "label": "GPT-OSS: a Harmony tool call in text mode",
        "code": "fmt = get_formatter(\"openai/gpt-oss-20b\")\nfmt.parse_tool_calls('<|channel|>commentary to=functions.get_weather <|constrain|>json<|message|>{\"city\": \"Tokyo\"}<|call|>')",
        "output": "[]"
      },
      {
        "label": "MiniMax: a real MiniMax M2 tool call",
        "code": "fmt = get_formatter(\"MiniMax-M2\")\nfmt.model_family(), fmt.parse_tool_calls('<minimax:tool_call><invoke name=\"get_weather\"><parameter name=\"city\">Tokyo</parameter></invoke></minimax:tool_call>')",
        "output": "('generic', [])"
      }
    ]
  }
}
