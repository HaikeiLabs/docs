{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "num": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "seo_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "description": "Optional search title for <title> and og:title. Defaults to \"<title> \u00b7 Agentware course\"."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "Optional meta description. Defaults to the lede as plain text, cut to 160 characters."
    },
    "mins": {
      "type": "integer",
      "minimum": 1
    },
    "lede": {
      "type": "string",
      "minLength": 1
    },
    "quiz": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "opts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 4
        },
        "a": {
          "type": "integer",
          "minimum": 0
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "q",
        "opts",
        "a",
        "why"
      ],
      "additionalProperties": false
    },
    "finish": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "num",
    "title",
    "mins",
    "lede",
    "quiz"
  ],
  "additionalProperties": false
}
