{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "seo_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "description": "Optional search title for <title> and og:title. Defaults to \"<title> \u00b7 Haikei docs\"."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "type": {
      "const": "read-and-use"
    },
    "product": {
      "const": "agentware"
    },
    "nav_group": {
      "type": "string"
    },
    "nav_order": {
      "type": "integer"
    },
    "course": {
      "enum": ["agentware", "evals"]
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "label",
          "from"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "finish": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label",
            "href"
          ],
          "additionalProperties": false
        },
        "secondary": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label",
            "href"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "primary",
        "secondary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "description",
    "type",
    "product",
    "course",
    "lessons",
    "groups",
    "finish"
  ],
  "additionalProperties": false
}
