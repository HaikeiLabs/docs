                  "type": "object"
                }
              },
              "response": {
                "type": "object"
              }
            },
            "required": [
              "kind",
              "messages",
              "response"
            ]
          },
          {
            "properties": {
              "kind": {
                "const": "reasoning"
              },
              "raw_content": {
                "type": "string"
              },
              "reasoning": {
                "type": "string"
              },
              "clean": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "raw_content",
              "reasoning",
              "clean"
