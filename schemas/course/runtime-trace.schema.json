                "type": "string"
              }
            },
            "required": [
              "kind",
              "tool",
              "args",
              "action",
              "rule",
              "reason",
              "subject"
            ]
          },
          {
            "properties": {
              "kind": {
                "const": "execute"
              },
              "tool": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "status": {
                "type": "string"
              },
              "output": {
                "type": "string"
              },
